{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "entryFile": "apps/api/main.js",
  "sourceRoot": "apps/api",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "../generated/prisma",
        "outDir": "../dist/generated/prisma",
        "watchAssets": true
      }
    ],
    "watchAssets": true
  },
  "projects": {
    "track-processing": {
      "type": "application",
      "root": "apps/track-processing",
      "entryFile": "apps/track-processing/main.js",
      "sourceRoot": "apps/track-processing"
    },
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "apps/api/main.js",
      "sourceRoot": "apps/api"
    }
  }
}

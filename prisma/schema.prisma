// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Track {
  id           String         @id @default(uuid())
  artist       String
  artistId     String         @map("artist_id")
  title        String
  album        String
  releaseDate  String         @map("release_date")
  durationMs   Int            @map("duration_ms")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  TrackVariant TrackVariant[]

  @@index([artistId])
}

model TrackVariant {
  id             String           @id @unique
  trackId        String           @map("track_id")
  Track          Track            @relation(fields: [trackId], references: [id], onDelete: Cascade)
  score          Int
  popularity     Int            
  imageUrl       String?          @map("image_url")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  isSourceTrack  Boolean          @default(false) @map("is_source_track")
  profiles       Profile[]        @relation("ProfileTrackVariants")

  @@index([id])
  @@index([trackId, isSourceTrack])
  @@unique([trackId, id, isSourceTrack])
}

model Profile {
  id             String           @unique @id
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  snapshotId     String           @map("snapshot_id")
  trackVariants  TrackVariant[]   @relation("ProfileTrackVariants")

  @@index([id])
}
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model Track {
  id           String         @id @default(uuid())
  artist       String
  title        String
  album        String
  releaseDate  String         @map("release_date")
  durationMs   Int            @map("duration_ms")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  TrackVariant TrackVariant[]
}

model TrackVariant {
  id             String           @id @default(uuid())
  trackId        String           @map("track_id")
  Track          Track            @relation(fields: [trackId], references: [id], onDelete: Cascade)
  spotifyId      String           @map("spotify_id")
  score          Int
  popularity     Int            
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  isSourceTrack  Boolean          @default(false) @map("is_source_track")
  ProfileLibrary ProfileLibrary[]

  @@unique([trackId, isSourceTrack])
  @@index([spotifyId])
  @@index([trackId, isSourceTrack])
}

model Profile {
  id             String           @unique // will be the Spotify user ID
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  snapshotId     String           @map("snapshot_id")
  ProfileLibrary ProfileLibrary[]

  @@index([id])
}

model ProfileLibrary {
  id             String       @id @default(uuid())
  profileId      String       @map("profile_id")
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  trackVariantId String       @map("track_variant_id")
  trackVariant   TrackVariant @relation(fields: [trackVariantId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([profileId, trackVariantId])
  @@index([profileId])
  @@index([trackVariantId])
  @@index([profileId, trackVariantId])
}
